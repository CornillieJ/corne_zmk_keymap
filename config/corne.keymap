#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&led_strip { chain-length = <27>; };

/ {
    underglow {
        compatible = "zmk,rgb-underglow";
        label = "RGB Underglow";

        // Define total LED count

        chain-length = <27>;

        // Define the split for different effects

        segments = <6>, <21>;

        // Colors for each segment

        segment-colors =
            <0xFF0000>,
            // Red for the first 6 LEDs (underneath),,,,,,,,,,,,,,,,,,,,,
            <0x00FF00>;

        // Green for the next 21 LEDs (on top)
    };

    combos { compatible = "zmk,combos"; };

    macros {
        euro: euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_8>,
                <&macro_release>,
                <&kp LALT>;

            label = "EURO";
            wait-ms = <15>;
        };

        next_BG: next_BG {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_CONTROL>,
                <&macro_tap>,
                <&kp FSLH>,
                <&macro_release>,
                <&kp RIGHT_CONTROL>;

            label = "NEXT_BG";
            wait-ms = <15>;
        };

        email: email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp J &kp E &kp F &kp F &kp R &kp E &kp Y &kp DOT &kp C &kp O &kp R &kp N &kp I &kp L &kp L &kp I &kp E &kp AT &kp H &kp O &kp T &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "EMAIL";
        };

        name: name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(J) &kp E &kp F &kp F &kp R &kp E &kp Y &kp SPACE &kp LS(C) &kp O &kp R &kp N &kp I &kp L &kp L &kp I &kp E>;
            label = "NAME";
        };

        ysiw_surround: ysiw_surround {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Y &kp S &kp I &kp W>;
            label = "YSIW_SURROUND";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Glaze {
            bindings = <
&kp TAB           &kp Q  &kp W  &kp F     &kp P           &kp G    &kp J            &kp L      &kp U      &kp Y    &kp SEMI  &kp DELETE
&kp LALT          &kp A  &kp R  &kp S     &kp T           &kp D    &kp H            &kp N      &kp E      &kp I    &kp O     &kp ENTER
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C     &kp V           &kp B    &kp K            &kp M      &kp COMMA  &kp DOT  &kp FSLH  &mo 4
                                &kp RALT  &kp LEFT_SHIFT  &mo 2    &lt 3 BACKSPACE  &kp SPACE  &kp LCTRL
            >;
        };

        default_layer {
            bindings = <
&kp TAB           &kp Q  &kp W  &kp F          &kp P           &kp G    &kp J            &kp L      &kp U      &kp Y    &kp SEMI  &kp DELETE
&kp LALT          &kp A  &kp R  &kp S          &kp T           &kp D    &kp H            &kp N      &kp E      &kp I    &kp O     &kp ENTER
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C          &kp V           &kp B    &kp K            &kp M      &kp COMMA  &kp DOT  &kp FSLH  &mo 4
                                &kp LEFT_META  &kp LEFT_SHIFT  &mo 2    &lt 3 BACKSPACE  &kp SPACE  &kp LCTRL
            >;
        };

        Numbers_Media {
            bindings = <
&none             &none            &kp PAGE_DOWN  &kp C_REWIND      &kp C_FAST_FORWARD  &kp C_VOLUME_UP      &kp PLUS   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK   &kp BACKSPACE
&none             &kp PRINTSCREEN  &kp END        &kp K_PLAY_PAUSE  &kp C_PLAY_PAUSE    &kp C_VOLUME_DOWN    &kp EQUAL  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH      &kp NON_US_BACKSLASH
&ext_power EP_ON  &none            &kp K_CUT      &kp K_COPY        &kp K_PASTE         &kp LS(INSERT)       &kp MINUS  &kp N1        &kp N2        &kp N3        &kp LESS_THAN  &kp GREATER_THAN
                                                  &trans            &trans              &trans               &kp COMMA  &kp DOT       &kp NUMBER_0
            >;
        };

        Nav_Symbols {
            bindings = <
&kp GRAVE  &kp CARET    &kp PIPE          &kp AMPERSAND      &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp CARET  &kp DOLLAR  &kp PERCENT  &kp G    &ysiw_surround  &kp TILDE
&kp EXCL   &kp DOLLAR   &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LEFT_BRACE        &kp RIGHT_BRACE          &kp B      &kp LEFT    &kp DOWN     &kp UP   &kp RIGHT       &kp W
&kp AT     &kp PERCENT  &kp POUND         &kp UNDERSCORE     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &euro      &kp F14     &kp F15      &kp F16  &kp F17         &kp K_CONTEXT_MENU
                                          &kp ESCAPE         &kp LEFT_GUI          &caps_word               &trans     &name       &email
            >;
        };

        function_layer {
            bindings = <
&to 5     &kp F1   &kp F2   &kp F3    &kp F4     &kp F5         &kp F6       &kp F7     &kp F8      &kp F9             &kp F10             &out OUT_TOG
&to 0     &kp F11  &kp F12  &kp F13   &soft_off  &bootloader    &bootloader  &soft_off  &sys_reset  &none              &none               &none
&kp CAPS  &email   &none    &none     &to 0      &to 1          &none        &none      &none       &kp LS(LA(SLASH))  &kp LC(LS(ESCAPE))  &none
                            &mkp MB4  &mkp MB5   &kp TAB        &mo 7        &mkp MB1   &mkp MB2
            >;
        };

        gaming {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E         &kp R      &kp T    &kp Y    &kp U      &kp I      &kp O      &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D         &kp F      &kp G    &kp H    &kp J      &kp K      &kp L      &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C         &kp V      &kp B    &kp B    &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH
                         &kp LEFT_ALT  &kp SPACE  &mo 6    &kp ESC  &kp SPACE  &kp ENTER
            >;
        };

        gaming_menu {
            bindings = <
&kp ESC       &kp N1     &kp N2  &kp N3            &kp N4        &kp N5    &trans  &trans  &trans  &trans  &trans  &to 0
&kp LEFT_ALT  &kp N6     &kp N7  &kp N8            &kp N9        &kp N0    &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL     &kp ENTER  &kp M   &kp K             &kp I         &kp J     &trans  &trans  &trans  &trans  &trans  &trans
                                 &kp C_PLAY_PAUSE  &kp LEFT_GUI  &trans    &trans  &trans  &trans
            >;
        };

        dangerous {
            bindings = <
&none  &none  &none  &none  &none  &out OUT_TOG      &bl BL_ON    &bl BL_OFF  &none       &none  &none  &none
&none  &none  &none  &none  &none  &bootloader       &bootloader  &none       &none       &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock    &bt BT_PRV   &bt BT_NXT  &bt BT_CLR  &none  &none  &none
                     &none  &none  &none             &none        &none       &none
            >;
        };
    };
};
