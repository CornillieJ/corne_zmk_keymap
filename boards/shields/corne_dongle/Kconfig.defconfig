if SHIELD_CORNE_DONGLE

config ZMK_KEYBOARD_NAME
    default "Corne Black"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# nrf52840_mdk_usb_dongle has no ZMK-native board defconfig (unlike
# nice_nano, which sets these itself), and neither ZMK_BLE nor ZMK_USB
# auto-enables on its own - without this, CONFIG_BT never gets selected
# at all, so the central never scans for peripherals.
config ZMK_BLE
    default y

config ZMK_USB
    default y

config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

# Zephyr's software link-layer (BT_LL_SW_SPLIT, used here since this board
# has no Nordic SoftDevice) defaults BT_CTLR_RX_BUFFERS to just 1. With two
# peripherals reconnecting to this central at nearly the same instant - the
# normal case right after this dongle cold-boots, e.g. after the host PC was
# powered off overnight, versus day-to-day operation where reconnects are
# rarely simultaneous - a single shared RX buffer is a plausible bottleneck
# for the concurrent GATT discovery both peripherals trigger at once. This
# mirrors the same class of bug fixed upstream for BT_ATT_TX_COUNT in
# https://github.com/zmkfirmware/zmk/pull/3216 (zmkfirmware/zmk#3156):
# GATT discovery for one peripheral's position-state characteristic can
# silently abort mid-discovery when a concurrent operation for the other
# peripheral exhausts a shared resource, leaving that peripheral showing
# "connected" while never actually registering key events.
config BT_CTLR_RX_BUFFERS
    default 8

endif
