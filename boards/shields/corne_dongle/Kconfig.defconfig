if SHIELD_CORNE_DONGLE

config ZMK_KEYBOARD_NAME
    default "Corne Blue"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# nrf52840_mdk_usb_dongle has no ZMK-native board defconfig (unlike
# nice_nano, which sets these itself), and neither ZMK_BLE nor ZMK_USB
# auto-enables on its own - without this, CONFIG_BT never gets selected
# at all, so the central never scans for peripherals.
config ZMK_BLE
    default y

config ZMK_USB
    default y

config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
